% ============================================================
%  tackettdoc.sty
%  Shared style for Ronald J. Tackett, Ph.D. professional documents
%  (CV, Teaching Philosophy, Administrative Philosophy, AI Statement)
%
%  Engine: LuaLaTeX (fontspec required)
%
%  CHANGELOG
%  v1.0  2026-09-03  Initial style file. Reconstructed to match the
%                    March 2026 PDF design: Roboto family, accent
%                    #2E4057, rule weights and footer layout sampled
%                    from Tackett_CV_Redesigned.pdf and
%                    Teaching_Philosophy_Tackett.pdf.
% ============================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tackettdoc}[2026/09/03 v1.0 Tackett professional document style]

\RequirePackage{fontspec}
\RequirePackage{xcolor}
\RequirePackage{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{graphicx}
\RequirePackage{tabularx}
\RequirePackage{enumitem}
\RequirePackage{microtype}
\RequirePackage{needspace}
\RequirePackage[hidelinks]{hyperref}

% ── Page geometry ───────────────────────────────────────────
\geometry{
  letterpaper,
  left=1.1in, right=1.1in,
  top=0.85in, bottom=1.0in,
  footskip=0.45in
}

% ── Palette (sampled from the original PDFs) ────────────────
\definecolor{accent}{HTML}{2E4057}
\definecolor{bodytext}{HTML}{1A1A1A}
\definecolor{subtext}{HTML}{3B3B3B}
\definecolor{mutedtext}{HTML}{434343}
\definecolor{rulelight}{HTML}{C9C9C9}
\definecolor{footgray}{HTML}{4E4E4E}

% ── Fonts ───────────────────────────────────────────────────
\setmainfont{Roboto}[
  Path            = fonts/,
  Extension       = .ttf,
  UprightFont     = *-400-normal,
  ItalicFont      = *-400-italic,
  BoldFont        = *-700-normal,
  BoldItalicFont  = *-700-italic
]
\newfontfamily\robotolight{Roboto}[
  Path        = fonts/,
  Extension   = .ttf,
  UprightFont = *-300-normal,
  ItalicFont  = *-300-italic
]
\newfontfamily\robotomedium{Roboto}[
  Path        = fonts/,
  Extension   = .ttf,
  UprightFont = *-500-normal
]

\color{bodytext}

% ── Paragraph handling ──────────────────────────────────────
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.55em}
\linespread{1.02}
\setlength{\emergencystretch}{2.5em}
\RequirePackage{url}
\def\UrlBreaks{\do\/\do\.\do\-\do\_}

% ── Footer ──────────────────────────────────────────────────
\newcommand{\doclabel}{}
\newcommand{\updated}{}
\newcommand{\setdoclabel}[1]{\renewcommand{\doclabel}{#1}}
\newcommand{\setupdated}[1]{\renewcommand{\updated}{#1}}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancyfoot[L]{\robotolight\footnotesize\color{footgray}Last updated: \updated}
\fancyfoot[C]{\robotolight\footnotesize\color{footgray}\doclabel}
\fancyfoot[R]{\robotolight\footnotesize\color{footgray}Page \thepage}

% ── Name block ──────────────────────────────────────────────
% \nameblock{role line}{institution line}
\newcommand{\nameblock}[2]{%
  {\color{accent}\fontsize{27}{30}\selectfont\robotolight Ronald J.\ \textbf{\rmfamily\bfseries Tackett, Ph.D.}\par}%
  \vspace{0.35em}
  {\color{subtext}\fontsize{10}{13}\selectfont\bfseries #1\par}%
  {\color{mutedtext}\fontsize{9.5}{12}\selectfont\robotolight #2\par}%
}

% ── Statement header: name block + thin rule + doc title ────
% \statementheader{role}{institution}{document title}
\newcommand{\statementheader}[3]{%
  \nameblock{#1}{#2}
  \vspace{0.9em}
  {\color{rulelight}\hrule height 0.5pt}
  \vspace{1.4em}
  {\color{accent}\fontsize{11.5}{14}\selectfont\bfseries #3\par}
  \vspace{0.55em}
  {\color{accent}\hrule height 1.6pt}
  \vspace{1.5em}
}

% ── Lede (italic opening paragraph) ─────────────────────────
\newcommand{\lede}[1]{%
  {\itshape #1\par}
  \vspace{0.9em}
}

% ── Statement section heading ───────────────────────────────
\newcommand{\stsection}[1]{%
  \needspace{5\baselineskip}
  \vspace{0.9em}
  {\color{accent}\fontsize{11}{13}\selectfont\MakeUppercase{#1}\par}
  \vspace{0.5em}
  {\color{accent}\hrule height 1.3pt}
  \vspace{0.9em}
  \nopagebreak
}

% ── CV section / subsection headings ────────────────────────
\newcommand{\cvsection}[1]{%
  \needspace{9\baselineskip}
  \vspace{0.9em}
  {\color{accent}\fontsize{11.5}{14}\selectfont\bfseries\MakeUppercase{#1}\par}
  \vspace{0.55em}
  {\color{accent}\hrule height 1.6pt}
  \vspace{0.9em}
  \nopagebreak
}
\newcommand{\cvsubsection}[1]{%
  \needspace{6\baselineskip}
  \vspace{0.7em}
  {\color{accent}\fontsize{10}{12}\selectfont\bfseries\itshape #1\par}
  \vspace{0.4em}
  {\color{rulelight}\hrule height 0.5pt}
  \vspace{0.7em}
  \nopagebreak
}

% ── CV entry: title/subtitle on the left, date flush right ──
% \cventry{title}{subtitle}{date}
\newcommand{\cventry}[3]{%
  \needspace{2.5\baselineskip}
  \begingroup
  \setlength{\parskip}{0pt}
  {\fontsize{10}{12}\selectfont\bfseries #1\hfill
   \normalfont{\color{mutedtext}\fontsize{9}{11}\selectfont #3}\par}
  \vspace{0.05em}
  {\color{mutedtext}\fontsize{9}{11}\selectfont\itshape #2\par}
  \endgroup
  \vspace{0.3em}
}

% ── CV service-style row: date | role | organization ────────
\newlength{\cvdatecol}
\setlength{\cvdatecol}{0.8in}
\newenvironment{cvtable}
  {\vspace{0.1em}%
   \begin{tabular}{@{}p{\cvdatecol}@{}>{\raggedright\arraybackslash}p{\dimexpr\textwidth-\cvdatecol\relax}@{}}}
  {\end{tabular}\vspace{0.3em}}
\newcommand{\cvrow}[3]{%
  {\color{mutedtext}\fontsize{9}{11}\selectfont #1} &
  {\fontsize{9.5}{11.5}\selectfont #2\ {\color{mutedtext}\itshape\textperiodcentered\ #3}}
  \tabularnewline[0.28em]
}

% ── Publication / presentation list ─────────────────────────
\newenvironment{reflist}
  {\begin{list}{}{%
     \setlength{\leftmargin}{1.5em}\setlength{\itemindent}{-1.5em}
     \setlength{\itemsep}{0.35em}\setlength{\parsep}{0pt}
     \setlength{\topsep}{0.2em}}%
   \fontsize{9.5}{11.5}\selectfont}
  {\end{list}}

% ── Closing signature block ─────────────────────────────────
\newcommand{\signatureblock}[1]{%
  \vspace{1.6em}
  {\color{accent}\fontsize{10.5}{13}\selectfont\bfseries Ronald J. Tackett, Ph.D.\par}
  {\color{subtext}\fontsize{9.5}{12}\selectfont\robotolight
    Founding Head, School of Foundational Studies\par
    Associate Professor of Physics\par
    Kettering University \textperiodcentered\ #1\par}
}

\endinput
